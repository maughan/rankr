generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListVisibility {
  public
  hidden
  draft
  private
}

enum ArchetypeSlug {
  contrarian
  oracle
  purist
  diplomat
  enthusiast
  critic
  wildcard
}

enum ActivityEventType {
  published
  ranked
  hot_take
  milestone
}

enum UserRole {
  user
  admin
  super_admin
}

enum ReportReason {
  spam
  harassment
  hateful
  sexual
  copyright
  minors
  violence
  other
}

enum ReportStatus {
  open
  reviewing
  actioned
  dismissed
}

enum ReportableType {
  list
  item
  profile
}

enum ModerationActionType {
  dismiss_report
  take_down
  restore
  warn_user
  suspend_user
  ban_user
  unsuspend_user
  unban_user
}

model Tier {
  id    Int    @id @default(autoincrement())
  title String
  color String
  value Int
  items Int[]
  lists List[] @relation("ListToTier")
}

model Item {
  id          Int       @id @default(autoincrement())
  img         String?
  name        String?
  color       String?
  short_label String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  createdById Int

  // Edit-audit fields
  name_updated_at      DateTime?
  image_uploaded_at    DateTime?
  short_label_user_set Boolean   @default(false)

  // Moderation
  deleted_at    DateTime?
  taken_down_at DateTime?

  createdBy      User            @relation(fields: [createdById], references: [id])
  rankings       Ranking[]
  lists          List[]          @relation("ItemToList")
  activityEvents ActivityEvent[]
}

model User {
  id                   Int                   @id @default(autoincrement())
  username             String                @unique
  password             String
  email                String?               @unique
  tokenVersion         Int                   @default(0)
  display_name         String?
  bio                  String?
  username_changed_at  DateTime?
  createdAt            DateTime              @default(now())
  follower_count       Int                   @default(0)
  following_count      Int                   @default(0)
  archetype            ArchetypeSlug?
  archetype_stats      Json?
  archetype_computed_at  DateTime?
  last_feed_visit_at     DateTime?

  // Moderation
  role            UserRole  @default(user)
  suspended_until DateTime?
  banned_at       DateTime?
  ban_reason      String?

  lists                List[]                @relation("CreatedLists")
  rankings             Ranking[]
  items                Item[]
  pins                 UserListPin[]
  usernameHistory      UserUsernameHistory[]
  following            Follow[]              @relation("Follower")
  followers            Follow[]              @relation("Following")
  blocking             Block[]               @relation("Blocker")
  blockedBy            Block[]               @relation("Blocked")
  invitesReceived      ListInvite[]          @relation("InvitedUser")
  invitesSent          ListInvite[]          @relation("InvitedBy")
  activityEvents       ActivityEvent[]
  reports_filed        Report[]              @relation("ReporterUser")
  reports_reviewed     Report[]              @relation("ReviewerUser")
  moderation_actions   ModerationAction[]    @relation("AdminActions")
  taken_down_lists     List[]                @relation("ListTakenDownBy")
}

model Follow {
  followerId   Int
  followingId  Int
  createdAt    DateTime @default(now())

  follower  User @relation("Follower",  fields: [followerId],  references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Block {
  blockerId  Int
  blockedId  Int
  createdAt  DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model UserUsernameHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  username  String
  changedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([username])
}

model List {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  visibility  ListVisibility @default(draft)
  img         String?
  createdById Int
  createdBy   User     @relation("CreatedLists", fields: [createdById], references: [id])

  category       String   @default("other")

  // Human-readable URL fields
  short_id                   String    @unique
  slug                       String

  // Shareable-link fields
  is_shareable               Boolean   @default(false)
  share_token                String?   @unique
  share_token_created_at     DateTime?
  anonymous_rankings_enabled Boolean   @default(true)

  // Community contributions
  allow_contributions        Boolean   @default(false)

  // Editorial curation
  is_featured                Boolean   @default(false)

  // Publish tracking
  has_been_published         Boolean   @default(false)
  published_at               DateTime?

  // Moderation
  deleted_at        DateTime?
  taken_down_at     DateTime?
  taken_down_reason String?
  taken_down_by_id  Int?
  taken_down_by     User?    @relation("ListTakenDownBy", fields: [taken_down_by_id], references: [id], onDelete: SetNull)

  items          Item[]          @relation("ItemToList")
  tiers          Tier[]          @relation("ListToTier")
  pins           UserListPin[]
  rankings       Ranking[]
  invites        ListInvite[]
  activityEvents ActivityEvent[]
}

model UserListPin {
  id        Int      @id @default(autoincrement())
  userId    Int
  listId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  list List @relation(fields: [listId], references: [id])

  @@unique([userId, listId])
}

model ListInvite {
  id            Int      @id @default(autoincrement())
  listId        Int
  invite_token  String    @unique
  invitedUserId Int?
  invitedById   Int
  createdAt     DateTime  @default(now())
  revoked_at    DateTime?

  list        List  @relation(fields: [listId], references: [id], onDelete: Cascade)
  invitedUser User? @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  invitedBy   User  @relation("InvitedBy",   fields: [invitedById],   references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([invitedUserId])
}

model Ranking {
  id        Int      @id @default(autoincrement())
  itemId    Int
  userId    Int?
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Anonymous-ranking fields
  listId                  Int?
  is_anonymous            Boolean @default(false)
  anonymous_session_token String?
  submitter_ip_hash       String?

  item Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
  list List? @relation(fields: [listId], references: [id])

  @@index([listId, anonymous_session_token])
}

model ActivityEvent {
  id        Int               @id @default(autoincrement())
  actorId   Int
  type      ActivityEventType
  listId    Int
  itemId    Int?
  meta      Json?
  createdAt DateTime          @default(now())

  actor User  @relation(fields: [actorId], references: [id], onDelete: Cascade)
  list  List  @relation(fields: [listId], references: [id], onDelete: Cascade)
  item  Item? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([listId])
  @@index([createdAt])
  @@index([actorId, createdAt(sort: Desc)])
}

model Report {
  id                    Int            @id @default(autoincrement())
  reporter_user_id      Int?
  reporter_session_hash String?
  reportable_type       ReportableType
  reportable_id         Int
  reason                ReportReason
  context               String?
  status                ReportStatus   @default(open)
  created_at            DateTime       @default(now())
  reviewed_by_id        Int?
  reviewed_at           DateTime?
  resolution_notes      String?

  reporter    User? @relation("ReporterUser",  fields: [reporter_user_id], references: [id], onDelete: SetNull)
  reviewed_by User? @relation("ReviewerUser",  fields: [reviewed_by_id],   references: [id], onDelete: SetNull)

  @@unique([reporter_user_id, reportable_type, reportable_id])
  @@unique([reporter_session_hash, reportable_type, reportable_id])
  @@index([status, created_at])
  @@index([reportable_type, reportable_id])
}

model ModerationAction {
  id            Int                  @id @default(autoincrement())
  admin_user_id Int
  action_type   ModerationActionType
  target_type   ReportableType
  target_id     Int
  reason        String?
  notes         String?
  created_at    DateTime             @default(now())

  admin User @relation("AdminActions", fields: [admin_user_id], references: [id])

  @@index([admin_user_id])
  @@index([target_type, target_id])
  @@index([created_at])
}
