generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tier {
  id    Int    @id @default(autoincrement())
  title String
  color String
  value Int
  items Int[]
  lists List[] @relation("ListToTier")
}

model Item {
  id          Int       @id @default(autoincrement())
  img         String?
  name        String?
  color       String?
  short_label String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  createdById Int

  // Edit-audit fields
  name_updated_at      DateTime?
  image_uploaded_at    DateTime?
  short_label_user_set Boolean   @default(false)

  createdBy User      @relation(fields: [createdById], references: [id])
  rankings  Ranking[]
  lists     List[]    @relation("ItemToList")
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique
  password     String
  email        String?       @unique
  tokenVersion Int           @default(0)
  lists        List[]
  rankings     Ranking[]
  items        Item[]
  pins         UserListPin[]
}

model List {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  hidden      Boolean  @default(true)
  img         String?
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])

  tags           String[]
  category_icon  String   @default("ti-stack-2")
  category_color String   @default("blue")

  // Human-readable URL fields
  short_id                   String    @unique
  slug                       String

  // Shareable-link fields
  is_shareable               Boolean   @default(false)
  share_token                String?   @unique
  share_token_created_at     DateTime?
  anonymous_rankings_enabled Boolean   @default(true)

  // Community contributions
  allow_contributions        Boolean   @default(false)

  // Editorial curation
  is_featured                Boolean   @default(false)

  items    Item[]        @relation("ItemToList")
  tiers    Tier[]        @relation("ListToTier")
  pins     UserListPin[]
  rankings Ranking[]
}

model UserListPin {
  id        Int      @id @default(autoincrement())
  userId    Int
  listId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  list List @relation(fields: [listId], references: [id])

  @@unique([userId, listId])
}

model Ranking {
  id        Int      @id @default(autoincrement())
  itemId    Int
  userId    Int?
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Anonymous-ranking fields
  listId                  Int?
  is_anonymous            Boolean @default(false)
  anonymous_session_token String?
  submitter_ip_hash       String?

  item Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
  list List? @relation(fields: [listId], references: [id])

  @@index([listId, anonymous_session_token])
}
