generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListVisibility {
  public
  hidden
  draft
  private
}

enum ArchetypeSlug {
  contrarian
  oracle
  purist
  diplomat
  enthusiast
  critic
  wildcard
}

model Tier {
  id    Int    @id @default(autoincrement())
  title String
  color String
  value Int
  items Int[]
  lists List[] @relation("ListToTier")
}

model Item {
  id          Int       @id @default(autoincrement())
  img         String?
  name        String?
  color       String?
  short_label String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  createdById Int

  // Edit-audit fields
  name_updated_at      DateTime?
  image_uploaded_at    DateTime?
  short_label_user_set Boolean   @default(false)

  createdBy User      @relation(fields: [createdById], references: [id])
  rankings  Ranking[]
  lists     List[]    @relation("ItemToList")
}

model User {
  id                   Int                   @id @default(autoincrement())
  username             String                @unique
  password             String
  email                String?               @unique
  tokenVersion         Int                   @default(0)
  display_name         String?
  bio                  String?
  username_changed_at  DateTime?
  createdAt            DateTime              @default(now())
  follower_count       Int                   @default(0)
  following_count      Int                   @default(0)
  archetype            ArchetypeSlug?
  archetype_stats      Json?
  archetype_computed_at DateTime?
  lists                List[]
  rankings             Ranking[]
  items                Item[]
  pins                 UserListPin[]
  usernameHistory      UserUsernameHistory[]
  following            Follow[]              @relation("Follower")
  followers            Follow[]              @relation("Following")
  blocking             Block[]               @relation("Blocker")
  blockedBy            Block[]               @relation("Blocked")
  invitesReceived      ListInvite[]          @relation("InvitedUser")
  invitesSent          ListInvite[]          @relation("InvitedBy")
}

model Follow {
  followerId   Int
  followingId  Int
  createdAt    DateTime @default(now())

  follower  User @relation("Follower",  fields: [followerId],  references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Block {
  blockerId  Int
  blockedId  Int
  createdAt  DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model UserUsernameHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  username  String
  changedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([username])
}

model List {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  visibility  ListVisibility @default(draft)
  img         String?
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])

  tags           String[]
  category_icon  String   @default("ti-stack-2")
  category_color String   @default("blue")

  // Human-readable URL fields
  short_id                   String    @unique
  slug                       String

  // Shareable-link fields
  is_shareable               Boolean   @default(false)
  share_token                String?   @unique
  share_token_created_at     DateTime?
  anonymous_rankings_enabled Boolean   @default(true)

  // Community contributions
  allow_contributions        Boolean   @default(false)

  // Editorial curation
  is_featured                Boolean   @default(false)

  // Publish tracking
  has_been_published         Boolean   @default(false)
  published_at               DateTime?

  items    Item[]        @relation("ItemToList")
  tiers    Tier[]        @relation("ListToTier")
  pins     UserListPin[]
  rankings Ranking[]
  invites  ListInvite[]
}

model UserListPin {
  id        Int      @id @default(autoincrement())
  userId    Int
  listId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  list List @relation(fields: [listId], references: [id])

  @@unique([userId, listId])
}

model ListInvite {
  id            Int      @id @default(autoincrement())
  listId        Int
  invite_token  String    @unique
  invitedUserId Int?
  invitedById   Int
  createdAt     DateTime  @default(now())
  revoked_at    DateTime?

  list        List  @relation(fields: [listId], references: [id], onDelete: Cascade)
  invitedUser User? @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  invitedBy   User  @relation("InvitedBy",   fields: [invitedById],   references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([invitedUserId])
}

model Ranking {
  id        Int      @id @default(autoincrement())
  itemId    Int
  userId    Int?
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Anonymous-ranking fields
  listId                  Int?
  is_anonymous            Boolean @default(false)
  anonymous_session_token String?
  submitter_ip_hash       String?

  item Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
  list List? @relation(fields: [listId], references: [id])

  @@index([listId, anonymous_session_token])
}
